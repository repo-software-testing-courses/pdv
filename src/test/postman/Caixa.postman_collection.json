{
  "info": {
    "name": "PDV – Caixa",
    "description": "Testes de sistema do CaixaService pela camada HTTP.\n\nNão funcionais: segurança (acesso sem login, senha errada) e desempenho (toda requisição abaixo de 2000 ms).\n\nPré-requisito: sistema no ar (docker compose up -d) e nenhum caixa diário aberto. Diferente do teste de integração, não há rollback: a pasta 4 fecha o caixa aberto na pasta 3.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"[desempenho] responde em menos de 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "usuario",
      "value": "gerente"
    },
    {
      "key": "senha",
      "value": "123"
    },
    {
      "key": "caixaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Segurança (sem login)",
      "item": [
        {
          "name": "Logout (estado inicial)",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"sessão encerrada (302)\", () => pm.response.to.have.status(302));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            }
          }
        },
        {
          "name": "Listagem de caixas sem login redireciona para o login",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"redireciona (302)\", () => pm.response.to.have.status(302));",
                  "pm.test(\"vai para /login\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/login\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/caixa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "caixa"
              ]
            }
          }
        },
        {
          "name": "Fechar caixa sem login não é executado",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"redireciona (302)\", () => pm.response.to.have.status(302));",
                  "pm.test(\"vai para /login\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/login\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "caixa",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "senha",
                  "value": "{{senha}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/caixa/fechar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "caixa",
                "fechar"
              ]
            }
          }
        },
        {
          "name": "Login com senha errada é recusado",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"redireciona (302)\", () => pm.response.to.have.status(302));",
                  "pm.test(\"vai para /login?error\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/login?error\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{usuario}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "senha-errada",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          }
        }
